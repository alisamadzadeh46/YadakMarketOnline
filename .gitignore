# =============================================================================
# Sensitive data - must never be committed
# =============================================================================

# Environment files with real credentials (keep only the empty template)
.env
.env.*
*.env
!.env.example

# Machine specific files: restricted terms and redacted values of tools/repo_guard
*.local

# Machine or server specific settings
local_settings.py
settings_local.py
secrets/
secrets.json
credentials.json

# Keys, certificates and credential stores
*.pem
*.key
*.p12
*.pfx
*.jks
*.kdbx
*.ovpn
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*

# Databases and dumps (real customer and seller records)
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db
*.sql
*.dump
*.psql
*.rdb
*.mdb
*.accdb
*dumpdata*.json

# Backups and archives
backup/
backups/
*.bak
*.backup
*.old
*.orig
*~
*.zip
*.rar
*.7z
*.tar
*.gz
*.tgz

# Data exports
*export*.csv
*.xls
*.xlsx

# Database and message broker data (Docker volumes)
pgdata/
postgres_data/
postgres-data/
postgresql_data/
db_data/
db-data/
dbdata/
mysql_data/
mysql-data/
mariadb_data/
mongo_data/
mongodb_data/
redis_data/
redis-data/
rabbitmq_data/
rabbitmq-data/
mnesia/
elasticsearch_data/
volumes/

# Web server and message broker credentials
.htpasswd
*.htpasswd
.erlang.cookie

# User uploads (product photos, seller documents)
media/
uploads/

# Domain verification files served from the web root
/[0-9]*.txt

