# -----------------------------------------------------------------------------
# Environment template
#
# Copy this file to ".env" and fill in the real values on each machine.
# ".env" is git-ignored; never commit real values to this template.
# -----------------------------------------------------------------------------

# Core application
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Payment gateway (ZarinPal)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
ZARINPAL_CALLBACK_URL=

# SMS panel
SMS_PROVIDER=
SMS_API_KEY=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_NUMBER=
SMS_OTP_TEMPLATE=

# Trust seals rendered in the site footer (eNamad / Samandehi)
ENAMAD_ID=
ENAMAD_CODE=
SAMANDEHI_ID=

# Public contact information shown on the website
CONTACT_PHONE=
CONTACT_MOBILE=
CONTACT_EMAIL=
CONTACT_ADDRESS=
CONTACT_POSTAL_CODE=

# E-mail delivery
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Cache and background workers
REDIS_URL=

# Deployment target (use SSH keys; never store server passwords in files)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_SSH_PORT=22
DEPLOY_PATH=
