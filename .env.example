# -----------------------------------------------------------------------------
# Environment template
#
# Development:  cp .env.example .env        (read by docker-compose.yml)
# Production:   cp .env.example .env.prod   (read by docker-compose.prod.yml)
#
# Both copies are git-ignored. Never put real values in this template.
# -----------------------------------------------------------------------------

# ---- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3010
# Defaults to CORS_ALLOWED_ORIGINS (dev) or FRONTEND_URL (prod) when empty.
CSRF_TRUSTED_ORIGINS=
# Path of the Django admin, with a trailing slash. In production pick a random
# path (never admin/): nginx serves the admin only there and answers /admin/
# with a 404, so it refuses to start when both are the same.
ADMIN_URL=admin/
# Public URL of the storefront; used in SMS/e-mail links and payment callbacks.
FRONTEND_URL=http://localhost:3010

# ---- Site identity (SMS texts, e-mails, admin header) -----------------------
SITE_NAME=
SITE_SHORT_NAME=
SITE_TAGLINE=
# Postal address printed in e-mail footers (optional).
SITE_ADDRESS=
# Seller shown for products that are not linked to a supplier account.
DEFAULT_SELLER_NAME=

# ---- Database ---------------------------------------------------------------
POSTGRES_DB=yadakmart
POSTGRES_USER=yadak
POSTGRES_PASSWORD=
DATABASE_URL=postgres://yadak:<POSTGRES_PASSWORD>@postgres:5432/yadakmart

# ---- Cache, sessions and task queue -----------------------------------------
REDIS_URL=redis://redis:6379/2
# Production only: password of the Redis container.
REDIS_PASSWORD=
# RabbitMQ in development; production uses Redis as the broker.
CELERY_BROKER_URL=amqp://rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Orders and payments ----------------------------------------------------
# Minutes a buyer has to pay (upload a receipt or finish the online payment).
PAYMENT_RECEIPT_WINDOW_MINUTES=30
# Online gateway credentials (ZarinPal / BitPay merchant IDs) are entered by
# the site owner in the panel (Online gateway page) and stored in the
# database, not here.

# ---- SMS (Niazpardaz; "console" only logs messages) --------------------------
SMS_PROVIDER=console
NIAZPARDAZ_USERNAME=
NIAZPARDAZ_PASSWORD=
NIAZPARDAZ_LINE_NUMBER=
SMS_RATE_LIMIT=30/m
DEFAULT_SETTLEMENT_REMINDER_DAYS=2

# ---- E-mail (password reset, newsletter) ------------------------------------
# Without EMAIL_HOST, e-mails are printed to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# ---- Security (production) --------------------------------------------------
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False
JWT_COOKIE_DOMAIN=

# ---- Monitoring -------------------------------------------------------------
SENTRY_DSN=

# ---- Production edge --------------------------------------------------------
# Public origin used to build the frontend, e.g. https://shop.example.com
PUBLIC_ORIGIN=

# ---- Storefront (NEXT_PUBLIC_*, inlined into the frontend at build time) ----
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_SHORT_NAME=
NEXT_PUBLIC_SITE_TAGLINE=
NEXT_PUBLIC_SELLER_NAME=
# Comma separated; each entry is "<dial digits>|<display text>", display optional.
NEXT_PUBLIC_CONTACT_PHONES=
NEXT_PUBLIC_CONTACT_CITY=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_BALE_URL=
# eNamad badge: the "id" and "Code" values of the official snippet, plus the
# domain-ownership meta tag value. The badge is hidden while they are empty.
NEXT_PUBLIC_ENAMAD_ID=
NEXT_PUBLIC_ENAMAD_CODE=
NEXT_PUBLIC_ENAMAD_META=
NEXT_PUBLIC_BITPAY_TRUST_URL=
NEXT_PUBLIC_ZARINPAL_TRUST_URL=
# Map tiles for the address picker (defaults to OpenStreetMap).
NEXT_PUBLIC_MAP_TILES=
